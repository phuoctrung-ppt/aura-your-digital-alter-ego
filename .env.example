# Aura — environment variable names (AGENTS.md §13)
# Copy to apps/api/.env and/or apps/mobile/.env as needed.
# Values are empty on purpose — never commit real secrets.
# Local defaults for DATABASE_URL / OLLAMA_* are documented in docker/README.md.

# ── API ──────────────────────────────────────────────────────────────────────
DATABASE_URL=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
PORT=

# ── AI providers ─────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=
OLLAMA_CHAT_MODEL=
CHAT_FALLBACK_PROVIDER=       # vertex | openai_compatible (default vertex)
VERTEX_PROJECT_ID=
GOOGLE_CLOUD_QUOTA_PROJECT=   # optional; else VERTEX_PROJECT_ID / ADC quota_project_id
VERTEX_LOCATION=              # asia-southeast1
VERTEX_CHAT_MODEL=            # gemini-2.0-flash-001
LLM_FALLBACK_BASE_URL=        # optional openai_compatible path
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_CHAT_MODEL=
STT_PROVIDER=                 # whisper-local | whisper-api | gcp | fake
STT_FALLBACK_PROVIDER=        # gcp
WHISPER_BASE_URL=
GCP_SPEECH_LANGUAGE_CODE=     # default vi-VN
GCP_SPEECH_MODEL=              # default latest_long
GCP_SPEECH_ENCODING=           # leave empty; m4a/AAC auto-decodes to LINEAR16
GCP_SPEECH_SAMPLE_RATE_HERTZ=  # default 16000 after m4a→LINEAR16 decode
FFMPEG_PATH=                  # optional; required for GCP STT on Expo m4a uplink
TTS_PROVIDER=                 # local-silent | local | gcp | cloud | fake
TTS_FALLBACK_PROVIDER=        # gcp
TTS_BASE_URL=
TTS_API_KEY=
GCP_TTS_LANGUAGE_CODE=
GCP_TTS_VOICE_NAME=
GCP_TTS_AUDIO_ENCODING=

# ── Storage ──────────────────────────────────────────────────────────────────
AUDIO_STORAGE_PATH=
# S3_* later (not MVP)

# ── Mobile (public — safe to embed in client bundle) ─────────────────────────
EXPO_PUBLIC_API_URL=
