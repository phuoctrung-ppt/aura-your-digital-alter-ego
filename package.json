{
  "name": "aura",
  "version": "0.0.0",
  "private": true,
  "description": "Aura — VN-first voice mobile AI companion monorepo",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:api": "pnpm --filter @aura/api dev",
    "dev:mobile": "pnpm --filter @aura/mobile start",
    "build": "turbo run build --output-logs=full",
    "build:contracts": "pnpm --filter @aura/contracts build",
    "build:api": "pnpm --filter @aura/api build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.10.11"
  }
}
